# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000

# --- MongoDB ---------------------------------------------------------------
# MongoDB Atlas connection string (Database Access user + Network Access IP
# allowlist must both be set up first). See README.md "MongoDB setup".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/robohack?retryWrites=true&w=majority

# --- CORS --------------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
# Use * only for local testing.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# --- Registration limits -------------------------------------------------
MAX_TEAMS=30

# --- Google Sheets (service account) --------------------------------------
# See README.md "Google Sheets setup" for how to get these three values.
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYzExampleId
GOOGLE_SHEET_TAB=Registrations
GOOGLE_SERVICE_ACCOUNT_EMAIL=robohack-sheets@your-project-id.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON key exactly as-is,
# including the \n escape sequences — keep it in quotes on one line.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"
